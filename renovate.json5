{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  assignees: [ "mikejovyan" ],
  extends: [ "local>renovate-bot/renovate_config" ],
  packageRules: [
    {
      dependencyDashboardApproval: false,
      description: "Open PRs directly for major updates in this repo, instead of waiting on Dependency Dashboard approval",
      matchUpdateTypes: [ "major" ],
    },
  ],
}
