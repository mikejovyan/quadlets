# [listener]
# Port this bridge itself listens on - must match whatever port is used in
# Forgejo's own webhook "Target URL" field, which isn't configured here.
NTFY_PORT=8080

# [destination]
NTFY_TEMPLATE=github
NTFY_TOPIC=forgejo
NTFY_URL=http://ntfy:8080

# [filtering]
# event_type or event_type:action, comma-separated (e.g. pull_request:closed).
NTFY_ALLOWED_EVENTS=pull_request:closed,issues,issue_comment
# .repository.full_name allow list, comma-separated (deny always wins).
NTFY_ALLOWED_REPOS=mikejovyan/containers
# .sender.login allow list, comma-separated (deny always wins).
NTFY_ALLOWED_USERS=
# Glob pattern for a PR's base branch, or a push/create/delete ref
# (Forgejo's own branch filter syntax).
NTFY_BRANCH_FILTER=main
# .repository.full_name ignore list, comma-separated - wins over NTFY_ALLOWED_REPOS.
NTFY_IGNORED_REPOS=
# .sender.login ignore list, comma-separated - wins over NTFY_ALLOWED_USERS.
NTFY_IGNORED_USERS=mikejovyan

# [payload]
# Dotted payload paths to delete before forwarding, comma-separated.
NTFY_STRIP_FIELDS=pull_request.body,issue.body
