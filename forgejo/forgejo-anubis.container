[Unit]
Description=Forgejo Anubis anti-bot proxy container
After=forgejo-pod.service forgejo.service
Requires=forgejo-pod.service
Wants=forgejo.service

[Container]
AutoUpdate=registry
ContainerName=forgejo-anubis
Environment=BIND=:8080
Environment=SERVE_ROBOTS_TXT=true
Environment=TARGET=http://localhost:3000
Image=ghcr.io/techarohq/anubis:latest
LogDriver=journald
Notify=healthy
Pod=forgejo.pod
Timezone=local

HealthCmd=["anubis", "--healthcheck"]
HealthInterval=60s
HealthRetries=5
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
WantedBy=forgejo-pod.service
WantedBy=forgejo.service
