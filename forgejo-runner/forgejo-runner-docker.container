[Unit]
Description=Docker daemon (dind) for Forgejo runner jobs
Documentation=https://hub.docker.com/_/docker

[Container]
AutoUpdate=registry
ContainerName=forgejo-runner-docker
Exec=dockerd
HealthCmd=docker info
HealthInterval=5s
Image=forgejo-runner-dind:latest
LogDriver=journald
Network=forgejo-runner.network
Notify=healthy
# Privileged inside the rootless user namespace only; needed for dockerd and the binfmt registration
PodmanArgs=--privileged
Timezone=local
Volume=./daemon.json:/etc/docker/daemon.json:ro,Z
Volume=forgejo-runner-docker-data:/var/lib/docker
Volume=forgejo-runner-docker-sock:/var/run/docker-shared

[Service]
Restart=always

[Install]
WantedBy=default.target

[Quadlet]
DefaultDependencies=false
